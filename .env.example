# Copy to .env and fill in. .env is gitignored; keep it that way.

# ── Reactive Lasna: where the reactor lives ──────────────────────────────────
REACTIVE_RPC_URL=https://lasna-rpc.rnk.dev/
REACTIVE_CHAIN_ID=5318007

# ── Base Sepolia: the origin we watch, and the destination we call back to ───
# A testnet origin requires a testnet destination; they cannot be mixed.
ORIGIN_RPC_URL=https://sepolia.base.org
ORIGIN_CHAIN_ID=84532
DESTINATION_CHAIN_ID=84532

# The callback proxy on the chain the executor is deployed to. This address is
# chain-specific, and the wrong one fails silently: the executor compiles,
# deploys, and is simply never called by anything.
#   Base Sepolia      0x476F44b11F5C942c58f4c8E3d0300E5710743585
#   Ethereum Sepolia  0xAa14d9Cd0f788Ca23d11805986C1d8bd035D23b4
#   Unichain Sepolia  0x775c9B990ADe401060B78D0e98684eEf8d2466C1
CALLBACK_PROXY=0x476F44b11F5C942c58f4c8E3d0300E5710743585

# The stop fires at or below this price. 18 decimals, so this is 2000.
FLOOR_WEI=2000000000000000000000

# ── Funding ──────────────────────────────────────────────────────────────────
# The proxy bills the executor in the destination chain's native token, and the
# reactor pays for its own reactive transactions in lREACT. Both must hold a
# balance before the first event arrives, so both are funded at construction.
EXECUTOR_FUNDING_WEI=5000000000000000
REACTOR_FUNDING_WEI=5000000000000000000

# ── Signing ──────────────────────────────────────────────────────────────────
# One account, funded on Base Sepolia (ETH) and on Lasna (lREACT). Use a
# throwaway account that has never held anything of value.
#
# A keystore is the better option, and not for ceremony: --private-key puts the
# key in a command line, where other processes on this machine can read it.
#   cast wallet import deployer --interactive
#   ETH_KEYSTORE_ACCOUNT=deployer
#   ETH_PASSWORD=...
#
# Leave PRIVATE_KEY empty if you use a keystore.
PRIVATE_KEY=
# ETH_KEYSTORE_ACCOUNT=
# ETH_PASSWORD=

# Lasna may want legacy-type transactions. If the reactive deploy fails on
# transaction type, set this and run it again:
# REACTIVE_FORGE_ARGS=--legacy
